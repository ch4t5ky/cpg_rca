  "107374182785" [label="METHOD" AST_PARENT_FULL_NAME="main" AST_PARENT_TYPE="TYPE_DECL" CODE="func renderCurrencyLogo(currencyCode string) string {
	logos := map[string]string{
		\"USD\": \"$\",
		\"CAD\": \"$\",
		\"JPY\": \"¥\",
		\"EUR\": \"€\",
		\"TRY\": \"₺\",
		\"GBP\": \"£\",
	}

	logo := \"$\" //default
	if val, ok := logos[currencyCode]; ok {
		logo = val
	}
	return logo
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="handlers.go" FULL_NAME="main.renderCurrencyLogo" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="611" LINE_NUMBER_END="626" NAME="renderCurrencyLogo" ORDER="1" SIGNATURE="main.renderCurrencyLogo(string)string"];
