  "107374182848" [label="METHOD" AST_PARENT_FULL_NAME="main.frontendServer" AST_PARENT_TYPE="TYPE_DECL" CODE="func (fe *frontendServer) convertCurrency(ctx context.Context, money *pb.Money, currency string) (*pb.Money, error) {
	if avoidNoopCurrencyConversionRPC && money.GetCurrencyCode() == currency {
		return money, nil
	}
	return pb.NewCurrencyServiceClient(fe.currencySvcConn).
		Convert(ctx, &pb.CurrencyConversionRequest{
			From:   money,
			ToCode: currency})
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="rpc.go" FULL_NAME="main.frontendServer.convertCurrency" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="77" LINE_NUMBER_END="85" NAME="convertCurrency" ORDER="1" SIGNATURE="main.frontendServer.convertCurrency(context.Context, *github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Money, string)*github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Money"];
  "107374182849" [label="METHOD" AST_PARENT_FULL_NAME="main.frontendServer" AST_PARENT_TYPE="TYPE_DECL" CODE="func (fe *frontendServer) getShippingQuote(ctx context.Context, items []*pb.CartItem, currency string) (*pb.Money, error) {
	quote, err := pb.NewShippingServiceClient(fe.shippingSvcConn).GetQuote(ctx,
		&pb.GetQuoteRequest{
			Address: nil,
			Items:   items})
	if err != nil {
		return nil, err
	}
	localized, err := fe.convertCurrency(ctx, quote.GetCostUsd(), currency)
	return localized, errors.Wrap(err, \"failed to convert currency for shipping cost\")
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="rpc.go" FULL_NAME="main.frontendServer.getShippingQuote" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="87" LINE_NUMBER_END="97" NAME="getShippingQuote" ORDER="1" SIGNATURE="main.frontendServer.getShippingQuote(context.Context, []*github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.CartItem, string)*github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Money"];
  "107374182850" [label="METHOD" AST_PARENT_FULL_NAME="main.frontendServer" AST_PARENT_TYPE="TYPE_DECL" CODE="func (fe *frontendServer) getRecommendations(ctx context.Context, userID string, productIDs []string) ([]*pb.Product, error) {
	resp, err := pb.NewRecommendationServiceClient(fe.recommendationSvcConn).ListRecommendations(ctx,
		&pb.ListRecommendationsRequest{UserId: userID, ProductIds: productIDs})
	if err != nil {
		return nil, err
	}
	out := make([]*pb.Product, len(resp.GetProductIds()))
	for i, v := range resp.GetProductIds() {
		p, err := fe.getProduct(ctx, v)
		if err != nil {
			return nil, errors.Wrapf(err, \"failed to get recommended product info (#%s)\", v)
		}
		out[i] = p
	}
	if len(out) > 4 {
		out = out[:4] // take only first four to fit the UI
	}
	return out, err
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="rpc.go" FULL_NAME="main.frontendServer.getRecommendations" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="99" LINE_NUMBER_END="117" NAME="getRecommendations" ORDER="1" SIGNATURE="main.frontendServer.getRecommendations(context.Context, string, []string)[]*github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Product"];
  "107374182851" [label="METHOD" AST_PARENT_FULL_NAME="main.frontendServer" AST_PARENT_TYPE="TYPE_DECL" CODE="func (fe *frontendServer) getAd(ctx context.Context, ctxKeys []string) ([]*pb.Ad, error) {
	ctx, cancel := context.WithTimeout(ctx, time.Millisecond*100)
	defer cancel()

	resp, err := pb.NewAdServiceClient(fe.adSvcConn).GetAds(ctx, &pb.AdRequest{
		ContextKeys: ctxKeys,
	})
	return resp.GetAds(), errors.Wrap(err, \"failed to get ads\")
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="rpc.go" FULL_NAME="main.frontendServer.getAd" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="119" LINE_NUMBER_END="127" NAME="getAd" ORDER="1" SIGNATURE="main.frontendServer.getAd(context.Context, []string)[]*github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Ad"];
