  "107374182814" [label="METHOD" AST_PARENT_FULL_NAME="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/money" AST_PARENT_TYPE="TYPE_DECL" CODE="func Sum(l, r pb.Money) (pb.Money, error) {
	if !IsValid(l) || !IsValid(r) {
		return pb.Money{}, ErrInvalidValue
	} else if l.GetCurrencyCode() != r.GetCurrencyCode() {
		return pb.Money{}, ErrMismatchingCurrency
	}
	units := l.GetUnits() + r.GetUnits()
	nanos := l.GetNanos() + r.GetNanos()

	if (units == 0 && nanos == 0) || (units > 0 && nanos >= 0) || (units < 0 && nanos <= 0) {
		// same sign <units, nanos>
		units += int64(nanos / nanosMod)
		nanos = nanos % nanosMod
	} else {
		// different sign. nanos guaranteed to not to go over the limit
		if units > 0 {
			units--
			nanos += nanosMod
		} else {
			units++
			nanos -= nanosMod
		}
	}

	return pb.Money{
		Units:        units,
		Nanos:        nanos,
		CurrencyCode: l.GetCurrencyCode()}, nil
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="money/money.go" FULL_NAME="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/money.Sum" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="93" LINE_NUMBER_END="121" NAME="Sum" ORDER="1" SIGNATURE="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/money.Sum(github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Money, github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Money)github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Money"];
  "107374182815" [label="METHOD" AST_PARENT_FULL_NAME="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/money" AST_PARENT_TYPE="TYPE_DECL" CODE="func MultiplySlow(m pb.Money, n uint32) pb.Money {
	out := m
	for n > 1 {
		out = Must(Sum(out, m))
		n--
	}
	return out
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="money/money.go" FULL_NAME="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/money.MultiplySlow" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="125" LINE_NUMBER_END="132" NAME="MultiplySlow" ORDER="1" SIGNATURE="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/money.MultiplySlow(github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Money, uint32)github.com/GoogleCloudPlatform/microservices-demo/src/frontend/genproto.Money"];
