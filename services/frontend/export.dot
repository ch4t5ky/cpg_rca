  "107374182842" [label="METHOD" AST_PARENT_FULL_NAME="main.frontendServer" AST_PARENT_TYPE="TYPE_DECL" CODE="func (fe *frontendServer) getCurrencies(ctx context.Context) ([]string, error) {
	currs, err := pb.NewCurrencyServiceClient(fe.currencySvcConn).
		GetSupportedCurrencies(ctx, &pb.Empty{})
	if err != nil {
		return nil, err
	}
	var out []string
	for _, c := range currs.CurrencyCodes {
		if _, ok := whitelistedCurrencies[c]; ok {
			out = append(out, c)
		}
	}
	return out, nil
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="rpc.go" FULL_NAME="main.frontendServer.getCurrencies" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="30" LINE_NUMBER_END="43" NAME="getCurrencies" ORDER="1" SIGNATURE="main.frontendServer.getCurrencies(context.Context)[]string"];
