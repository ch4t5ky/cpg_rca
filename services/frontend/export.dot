  "107374182403" [label="METHOD" AST_PARENT_FULL_NAME="main" AST_PARENT_TYPE="TYPE_DECL" CODE="func init() {
	initializeLogger()
	// Use a goroutine to ensure loadDeploymentDetails()'s GCP API
	// calls don't block non-GCP deployments. See issue #685.
	go loadDeploymentDetails()
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="deployment_details.go" FULL_NAME="main.init" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="15" LINE_NUMBER_END="20" NAME="init" ORDER="1" SIGNATURE="main.init()"];
  "107374182404" [label="METHOD" AST_PARENT_FULL_NAME="main" AST_PARENT_TYPE="TYPE_DECL" CODE="func initializeLogger() {
	log = logrus.New()
	log.Level = logrus.DebugLevel
	log.Formatter = &logrus.JSONFormatter{
		FieldMap: logrus.FieldMap{
			logrus.FieldKeyTime:  \"timestamp\",
			logrus.FieldKeyLevel: \"severity\",
			logrus.FieldKeyMsg:   \"message\",
		},
		TimestampFormat: time.RFC3339Nano,
	}
	log.Out = os.Stdout
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="deployment_details.go" FULL_NAME="main.initializeLogger" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="22" LINE_NUMBER_END="34" NAME="initializeLogger" ORDER="1" SIGNATURE="main.initializeLogger()"];
  "107374182405" [label="METHOD" AST_PARENT_FULL_NAME="main" AST_PARENT_TYPE="TYPE_DECL" CODE="func loadDeploymentDetails() {
	deploymentDetailsMap = make(map[string]string)
	var metaServerClient = metadata.NewClient(&http.Client{})

	podHostname, err := os.Hostname()
	if err != nil {
		log.Error(\"Failed to fetch the hostname for the Pod\", err)
	}

	podCluster, err := metaServerClient.InstanceAttributeValue(\"cluster-name\")
	if err != nil {
		log.Error(\"Failed to fetch the name of the cluster in which the pod is running\", err)
	}

	podZone, err := metaServerClient.Zone()
	if err != nil {
		log.Error(\"Failed to fetch the Zone of the node where the pod is scheduled\", err)
	}

	deploymentDetailsMap[\"HOSTNAME\"] = podHostname
	deploymentDetailsMap[\"CLUSTERNAME\"] = podCluster
	deploymentDetailsMap[\"ZONE\"] = podZone

	log.WithFields(logrus.Fields{
		\"cluster\":  podCluster,
		\"zone\":     podZone,
		\"hostname\": podHostname,
	}).Debug(\"Loaded deployment details\")
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="deployment_details.go" FULL_NAME="main.loadDeploymentDetails" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="36" LINE_NUMBER_END="64" NAME="loadDeploymentDetails" ORDER="1" SIGNATURE="main.loadDeploymentDetails()"];
