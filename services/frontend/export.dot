  "107374182857" [label="METHOD" AST_PARENT_FULL_NAME="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/validator" AST_PARENT_TYPE="TYPE_DECL" CODE="func ValidationErrorResponse(err error) error {
	validationErrs, ok := err.(validator.ValidationErrors)
	if !ok {
		return errors.New(\"invalid validation error format\")
	}
	var msg string
	for _, err := range validationErrs {
		msg += fmt.Sprintf(\"Field '%s' is invalid: %s\\n\", err.Field(), err.Tag())
	}
	return fmt.Errorf(\"%s\", msg)
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="validator/validator.go" FULL_NAME="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/validator.ValidationErrorResponse" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="73" LINE_NUMBER_END="83" NAME="ValidationErrorResponse" ORDER="1" SIGNATURE="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/validator.ValidationErrorResponse(error)error"];
