	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			payload := PlaceOrderPayload{
				Email:         tt.email,
				StreetAddress: tt.streetAddress,
				ZipCode:       tt.zipCode,
				City:          tt.city,
				State:         tt.state,
				Country:       tt.country,
				CcNumber:      tt.ccNumber,
				CcMonth:       tt.ccMonth,
				CcYear:        tt.ccYear,
				CcCVV:         tt.ccCVV,
			}
			if err := payload.Validate(); err != nil {
				t.Errorf(\"want validation on %v, got %v\", payload, err)
			}
		})
	}
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="validator/validator_test.go" FULL_NAME="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/validator.TestPlaceOrderPassesValidation" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="22" LINE_NUMBER_END="57" NAME="TestPlaceOrderPassesValidation" ORDER="1" SIGNATURE="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/validator.TestPlaceOrderPassesValidation(*testing.T)"];
