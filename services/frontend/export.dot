  "107374182798" [label="METHOD" AST_PARENT_FULL_NAME="main.responseRecorder" AST_PARENT_TYPE="TYPE_DECL" CODE="func (r *responseRecorder) Write(p []byte) (int, error) {
	if r.status == 0 {
		r.status = http.StatusOK
	}
	n, err := r.w.Write(p)
	r.b += n
	return n, err
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="middleware.go" FULL_NAME="main.responseRecorder.Write" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="43" LINE_NUMBER_END="50" NAME="Write" ORDER="1" SIGNATURE="main.responseRecorder.Write([]uint8)int"];
