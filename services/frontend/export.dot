  "107374182773" [label="METHOD" AST_PARENT_FULL_NAME="main.frontendServer" AST_PARENT_TYPE="TYPE_DECL" CODE="func (fe *frontendServer) logoutHandler(w http.ResponseWriter, r *http.Request) {
	log := r.Context().Value(ctxKeyLog{}).(logrus.FieldLogger)
	log.Debug(\"logging out\")
	for _, c := range r.Cookies() {
		c.Expires = time.Now().Add(-time.Hour * 24 * 365)
		c.MaxAge = -1
		http.SetCookie(w, c)
	}
	w.Header().Set(\"Location\", baseUrl + \"/\")
	w.WriteHeader(http.StatusFound)
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="handlers.go" FULL_NAME="main.frontendServer.logoutHandler" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="418" LINE_NUMBER_END="428" NAME="logoutHandler" ORDER="1" SIGNATURE="main.frontendServer.logoutHandler(net/http.ResponseWriter, *net/http.Request)"];
