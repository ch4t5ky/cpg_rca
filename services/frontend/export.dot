  "107374182870" [label="METHOD" AST_PARENT_FULL_NAME="github.com/GoogleCloudPlatform/microservices-demo/src/frontend/validator" AST_PARENT_TYPE="TYPE_DECL" CODE="func TestSetCurrencyFailsValidation(t *testing.T) {
	tests := []struct {
		name     string
		currency string
	}{
		{\"invalid currency\", \"ABC\"},
		{\"invalid currency (symbol)\", \"$\"},
		{\"invalid (no currency)\", \"\"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			payload := SetCurrencyPayload{Currency: tt.currency}
			if err := payload.Validate(); err == nil {
				t.Errorf(\"want validation on %v, got %v\", payload, err)
			}
		})
	}
