  "107374182800" [label="METHOD" AST_PARENT_FULL_NAME="main.logHandler" AST_PARENT_TYPE="TYPE_DECL" CODE="func (lh *logHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	requestID, _ := uuid.NewRandom()
	ctx = context.WithValue(ctx, ctxKeyRequestID{}, requestID.String())

	start := time.Now()
	rr := &responseRecorder{w: w}
	log := lh.log.WithFields(logrus.Fields{
		\"http.req.path\":   r.URL.Path,
		\"http.req.method\": r.Method,
		\"http.req.id\":     requestID.String(),
	})
	if v, ok := r.Context().Value(ctxKeySessionID{}).(string); ok {
		log = log.WithField(\"session\", v)
	}
	log.Debug(\"request started\")
	defer func() {
		log.WithFields(logrus.Fields{
			\"http.resp.took_ms\": int64(time.Since(start) / time.Millisecond),
			\"http.resp.status\":  rr.status,
			\"http.resp.bytes\":   rr.b}).Debugf(\"request complete\")
	}()

	ctx = context.WithValue(ctx, ctxKeyLog{}, log)
	r = r.WithContext(ctx)
	lh.next.ServeHTTP(rr, r)
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="middleware.go" FULL_NAME="main.logHandler.ServeHTTP" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="57" LINE_NUMBER_END="83" NAME="ServeHTTP" ORDER="1" SIGNATURE="main.logHandler.ServeHTTP(net/http.ResponseWriter, *net/http.Request)"];
  "107374182801" [label="METHOD" AST_PARENT_FULL_NAME="main.ensureSessionID.<lambda>0" AST_PARENT_TYPE="TYPE_DECL" CODE="func(w http.ResponseWriter, r *http.Request) {
		var sessionID string
		c, err := r.Cookie(cookieSessionID)
		if err == http.ErrNoCookie {
			if os.Getenv(\"ENABLE_SINGLE_SHARED_SESSION\") == \"true\" {
				// Hard coded user id, shared across sessions
				sessionID = \"12345678-1234-1234-1234-123456789123\"
			} else {
				u, _ := uuid.NewRandom()
				sessionID = u.String()
			}
			http.SetCookie(w, &http.Cookie{
				Name:   cookieSessionID,
				Value:  sessionID,
				MaxAge: cookieMaxAge,
			})
		} else if err != nil {
			return
		} else {
			sessionID = c.Value
		}
		ctx := context.WithValue(r.Context(), ctxKeySessionID{}, sessionID)
		r = r.WithContext(ctx)
		next.ServeHTTP(w, r)
	}" COLUMN_NUMBER="9" COLUMN_NUMBER_END="3" FILENAME="middleware.go" FULL_NAME="main.ensureSessionID.<lambda>0" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="86" LINE_NUMBER_END="110" NAME="<lambda>0" ORDER="1" SIGNATURE="<lambda>(net/http.ResponseWriter, *net/http.Request)void"];
  "107374182802" [label="METHOD" AST_PARENT_FULL_NAME="main" AST_PARENT_TYPE="TYPE_DECL" CODE="func ensureSessionID(next http.Handler) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		var sessionID string
		c, err := r.Cookie(cookieSessionID)
		if err == http.ErrNoCookie {
			if os.Getenv(\"ENABLE_SINGLE_SHARED_SESSION\") == \"true\" {
				// Hard coded user id, shared across sessions
				sessionID = \"12345678-1234-1234-1234-123456789123\"
			} else {
				u, _ := uuid.NewRandom()
				sessionID = u.String()
			}
			http.SetCookie(w, &http.Cookie{
				Name:   cookieSessionID,
				Value:  sessionID,
				MaxAge: cookieMaxAge,
			})
		} else if err != nil {
			return
		} else {
			sessionID = c.Value
		}
		ctx := context.WithValue(r.Context(), ctxKeySessionID{}, sessionID)
		r = r.WithContext(ctx)
		next.ServeHTTP(w, r)
	}
}" COLUMN_NUMBER="1" COLUMN_NUMBER_END="2" FILENAME="middleware.go" FULL_NAME="main.ensureSessionID" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="85" LINE_NUMBER_END="111" NAME="ensureSessionID" ORDER="1" SIGNATURE="main.ensureSessionID(net/http.Handler)net/http.HandlerFunc"];
