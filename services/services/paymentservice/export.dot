  "107374182415" [label="METHOD" AST_PARENT_FULL_NAME="<empty>" AST_PARENT_TYPE="<empty>" CODE="listen() {
    const server = this.server 
    const port = this.port
    server.bindAsync(
      `[::]:${port}`,
      grpc.ServerCredentials.createInsecure(),
      function () {
        logger.info(`PaymentService gRPC server started on port ${port}`);
        server.start();
      }
    );
  }" COLUMN_NUMBER="2" COLUMN_NUMBER_END="3" FILENAME="server.js" FULL_NAME="server.js::program:HipsterShopServer:listen" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="57" LINE_NUMBER_END="68" NAME="listen" ORDER="1" SIGNATURE=""];
  "107374182416" [label="METHOD" AST_PARENT_FULL_NAME="<empty>" AST_PARENT_TYPE="<empty>" CODE="loadProto(path) {
    const packageDefinition = protoLoader.loadSync(
      path,
      {
        keepCase: true,
        longs: String,
        enums: String,
        defaults: true,
        oneofs: true
      }
    );
    return grpc.loadPackageDefinition(packageDefinition);
  }" COLUMN_NUMBER="2" COLUMN_NUMBER_END="3" FILENAME="server.js" FULL_NAME="server.js::program:HipsterShopServer:loadProto" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="70" LINE_NUMBER_END="82" NAME="loadProto" ORDER="1" SIGNATURE=""];
  "107374182417" [label="METHOD" AST_PARENT_FULL_NAME="<empty>" AST_PARENT_TYPE="<empty>" CODE="loadAllProtos(protoRoot) {
    const hipsterShopPackage = this.packages.hipsterShop.hipstershop;
    const healthPackage = this.packages.health.grpc.health.v1;

    this.server.addService(
      hipsterShopPackage.PaymentService.service,
      {
        charge: HipsterShopServer.ChargeServiceHandler.bind(this)
      }
    );

    this.server.addService(
      healthPackage.Health.service,
      {
        check: HipsterShopServer.CheckHandler.bind(this)
      }
    );
  }" COLUMN_NUMBER="2" COLUMN_NUMBER_END="3" FILENAME="server.js" FULL_NAME="server.js::program:HipsterShopServer:loadAllProtos" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="84" LINE_NUMBER_END="101" NAME="loadAllProtos" ORDER="1" SIGNATURE=""];
