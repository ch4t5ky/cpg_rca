  "98784247812" [label="MEMBER" AST_PARENT_FULL_NAME="<empty>" AST_PARENT_TYPE="<empty>" CODE="static ChargeServiceHandler(call, callback) {
    try {
      logger.info(`PaymentService#Charge invoked with request ${JSON.stringify(call.request)}`);
      const response = charge(call.request);
      callback(null, response);
    } catch (err) {
      console.warn(err);
      callback(err);
    }
  }" COLUMN_NUMBER="2" DYNAMIC_TYPE_HINT_FULL_NAME="server.js::program:HipsterShopServer:ChargeServiceHandler" GENERIC_SIGNATURE="<empty>" LINE_NUMBER="41" NAME="ChargeServiceHandler" ORDER="-1" POSSIBLE_TYPES="void" TYPE_FULL_NAME="ANY"];
  "98784247813" [label="MEMBER" AST_PARENT_FULL_NAME="<empty>" AST_PARENT_TYPE="<empty>" CODE="static CheckHandler(call, callback) {
    callback(null, { status: 'SERVING' });
  }" COLUMN_NUMBER="2" DYNAMIC_TYPE_HINT_FULL_NAME="server.js::program:HipsterShopServer:CheckHandler" GENERIC_SIGNATURE="<empty>" LINE_NUMBER="52" NAME="CheckHandler" ORDER="-1" POSSIBLE_TYPES="void" TYPE_FULL_NAME="ANY"];
  "98784247814" [label="MEMBER" AST_PARENT_FULL_NAME="<empty>" AST_PARENT_TYPE="<empty>" CODE="listen() {
    const server = this.server 
    const port = this.port
    server.bindAsync(
      `[::]:${port}`,
      grpc.ServerCredentials.createInsecure(),
      function () {
        logger.info(`PaymentService gRPC server started on port ${port}`);
        server.start();
      }
    );
  }" COLUMN_NUMBER="2" DYNAMIC_TYPE_HINT_FULL_NAME="server.js::program:HipsterShopServer:listen" GENERIC_SIGNATURE="<empty>" LINE_NUMBER="57" NAME="listen" ORDER="-1" POSSIBLE_TYPES="void" TYPE_FULL_NAME="ANY"];
  "98784247815" [label="MEMBER" AST_PARENT_FULL_NAME="<empty>" AST_PARENT_TYPE="<empty>" CODE="loadProto(path) {
    const packageDefinition = protoLoader.loadSync(
      path,
      {
        keepCase: true,
        longs: String,
        enums: String,
        defaults: true,
        oneofs: true
      }
    );
    return grpc.loadPackageDefinition(packageDefinition);
  }" COLUMN_NUMBER="2" DYNAMIC_TYPE_HINT_FULL_NAME="server.js::program:HipsterShopServer:loadProto" GENERIC_SIGNATURE="<empty>" LINE_NUMBER="70" NAME="loadProto" ORDER="-1" POSSIBLE_TYPES="ANY" TYPE_FULL_NAME="ANY"];
  "98784247816" [label="MEMBER" AST_PARENT_FULL_NAME="<empty>" AST_PARENT_TYPE="<empty>" CODE="loadAllProtos(protoRoot) {
    const hipsterShopPackage = this.packages.hipsterShop.hipstershop;
    const healthPackage = this.packages.health.grpc.health.v1;

    this.server.addService(
      hipsterShopPackage.PaymentService.service,
      {
        charge: HipsterShopServer.ChargeServiceHandler.bind(this)
      }
    );

    this.server.addService(
      healthPackage.Health.service,
      {
        check: HipsterShopServer.CheckHandler.bind(this)
      }
    );
