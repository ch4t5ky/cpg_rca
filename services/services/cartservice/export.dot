using System.Threading.Tasks;

namespace cartservice.cartstore
{
    public interface ICartStore
    {
        Task AddItemAsync(string userId, string productId, int quantity);
        Task EmptyCartAsync(string userId);
        Task<Hipstershop.Cart> GetCartAsync(string userId);
        bool Ping();
    }
}" HASH="a40beae831f84fc6d5426048f8bbe27805c661bb7ffdcf4249ddabc7c08f1d51" NAME="src/cartstore/ICartStore.cs" ORDER="1"];
  "60129542148" [label="FILE" CODE="<empty>" CONTENT="// Copyright 2018 Google LLC
