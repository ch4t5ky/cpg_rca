        {
            _cache = cache;
        }" COLUMN_NUMBER="8" COLUMN_NUMBER_END="9" FILENAME="src/cartstore/RedisCartStore.cs" FULL_NAME="cartservice.cartstore.RedisCartStore.<init>:System.Void(Microsoft.Extensions.Caching.Distributed.IDistributedCache)" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="27" LINE_NUMBER_END="30" NAME="<init>" ORDER="3" SIGNATURE="System.Void(Microsoft.Extensions.Caching.Distributed.IDistributedCache)"];
  "107374182423" [label="METHOD" AST_PARENT_FULL_NAME="<empty>" AST_PARENT_TYPE="<empty>" CODE="public async Task AddItemAsync(string userId, string productId, int quantity)
        {
            Console.WriteLine($\"AddItemAsync called with userId={userId}, productId={productId}, quantity={quantity}\");

            try
            {
                Hipstershop.Cart cart;
                var value = await _cache.GetAsync(userId);
                if (value == null)
                {
                    cart = new Hipstershop.Cart();
                    cart.UserId = userId;
                    cart.Items.Add(new Hipstershop.CartItem { ProductId = productId, Quantity = quantity });
                }
                else
                {
                    cart = Hipstershop.Cart.Parser.ParseFrom(value);
                    var existingItem = cart.Items.SingleOrDefault(i => i.ProductId == productId);
                    if (existingItem == null)
                    {
                        cart.Items.Add(new Hipstershop.CartItem { ProductId = productId, Quantity = quantity });
                    }
                    else
                    {
                        existingItem.Quantity += quantity;
                    }
                }
                await _cache.SetAsync(userId, cart.ToByteArray());
            }
            catch (Exception ex)
            {
                throw new RpcException(new Status(StatusCode.FailedPrecondition, $\"Can't access cart storage. {ex}\"));
            }
        }" COLUMN_NUMBER="8" COLUMN_NUMBER_END="9" FILENAME="src/cartstore/RedisCartStore.cs" FULL_NAME="cartservice.cartstore.RedisCartStore.AddItemAsync:System.Threading.Tasks.Task(System.String,System.String,System.Int32)" GENERIC_SIGNATURE="<empty>" IS_EXTERNAL="false" LINE_NUMBER="32" LINE_NUMBER_END="65" NAME="AddItemAsync" ORDER="4" SIGNATURE="System.Threading.Tasks.Task(System.String,System.String,System.Int32)"];
